# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Direct PostgreSQL URI for Migrations or Postgres MCP
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# ==========================================
# Email Gateway Configuration (SMTP)
# ==========================================
# Если параметры не указаны, система работает в безопасном тестовом режиме (Mock),
# выводя письма в лог консоли и фиксируя их в истории кандидата.
#
# Для личной почты Яндекс:
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=your_login@yandex.ru
# SMTP_PASS=your_app_password (пароль приложения из настроек Яндекс ID)
# SMTP_FROM=your_login@yandex.ru
# SMTP_SECURE=true
#
# Для личной почты Mail.ru:
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=your_login@mail.ru
# SMTP_PASS=your_app_password
# SMTP_FROM=your_login@mail.ru
#
# Для Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_login@gmail.com
# SMTP_PASS=your_app_password
#
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=true

# ==========================================
# SMS Gateway Configuration (SMS.ru)
# ==========================================
# Если ключ не указан, отправка работает в тестовом режиме (Mock),
# эмулируя успешную доставку и сохраняя историю в CRM без расхода баланса.
# Для реальной отправки укажите API-ключ из личного кабинета sms.ru:
SMS_RU_API_KEY=

